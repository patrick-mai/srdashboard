<?xml version="1.0" encoding="UTF-8"?>
<plugin id="analyse" label="Analyse" version="1.0.0" mode="shared" kind="display">
  <description>Session results one at a time — Classic Range view with a selector. Frozen starts survive a new shooter on the Bahn.</description>
  <entrypoints view="view.js" theme="theme.css"/>
  <config>
    <hideIdleRanges>false</hideIdleRanges>
    <defaultTargetProfile>air_rifle_10m</defaultTargetProfile>
    <disciplineTargets>
      <Luftgewehr>air_rifle_10m</Luftgewehr>
      <LG>air_rifle_10m</LG>
      <Luftpistole>air_pistol_10m</Luftpistole>
      <LP>air_pistol_10m</LP>
      <Kleinkaliber>smallbore_50m_prone</Kleinkaliber>
      <KK-Gewehr>smallbore_50m_prone</KK-Gewehr>
      <KK>smallbore_50m_prone</KK>
    </disciplineTargets>
  </config>
</plugin>
