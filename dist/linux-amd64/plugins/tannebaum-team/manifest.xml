<?xml version="1.0" encoding="UTF-8"?>
<plugin id="tannebaum-team" label="Tannebaum Team" version="1.0.0" mode="shared" kind="game">
  <description>Kegel-Tannebaum als Mannschaftsspiel — zwei Teams, ein Baum je Seite. Ein Treffer fällt die präziseste eigene Nadel, die er noch erreichen kann; nur Überschüsse gehen als Geschenk an das andere Team. Wer seinen Baum zuerst räumt, gewinnt.</description>
  <entrypoints view="view.js" theme="theme.css" logic="builtin"/>
  <assetsDir>assets</assetsDir>
  <config>
    <autoStartWhenAllReady>true</autoStartWhenAllReady>
    <defaultTargetProfile>air_rifle_10m</defaultTargetProfile>
    <teamAssignments></teamAssignments>
    <disciplineTargets>
      <Luftgewehr>air_rifle_10m</Luftgewehr>
      <LG>air_rifle_10m</LG>
      <Luftpistole>air_pistol_10m</Luftpistole>
      <LP>air_pistol_10m</LP>
      <Kleinkaliber>smallbore_50m_prone</Kleinkaliber>
      <KK-Gewehr>smallbore_50m_prone</KK-Gewehr>
      <KK>smallbore_50m_prone</KK>
    </disciplineTargets>
  </config>
</plugin>
