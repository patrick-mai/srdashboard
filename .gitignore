# Build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
/srdashboard
/send-shot
/replay-log
/docs/*
!/docs/*.md
/docs/DISAG_QR.md
/exampledata/

# Ship pre-built binaries for non-developers
!dist/**/*.exe

# Bundled plugins ship as folders in dist/<platform>/plugins/, not as zips
/dist/plugins/

# Go
/vendor/

# IDE / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local overrides / runtime
runtime.xml
plugins/*/config.xml
*.log
/log/
screenshots/.staging/
scripts/__pycache__/

# Local audio edits (optional; safe if missing)
fox-edit/

# Local SFX generation / preview (game uses the mixed files in static/sfx/)
static/sound-lab.html
scripts/gen_sfx.py
static/sfx/bingo-call.mp3
static/sfx/bingo-fanfare.mp3
static/sfx/bingo-applause.mp3

# DISAG ShotsApp → Ring Reader iOS shortcut (proprietary key schedule — keep local)
/shortcut/
