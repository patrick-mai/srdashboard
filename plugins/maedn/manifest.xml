<?xml version="1.0" encoding="UTF-8"?>
<plugin id="maedn" label="Mensch ärgere dich nicht" version="1.0.0" mode="shared" kind="game">
  <description>Ein Hut pro Bahn. 10.0 setzt ein, 9+ geht ein Feld, 10.5 zwei. Wer landet, schickt den anderen in den Hof. 6–7 tun nichts. Kein Exact-Count im Ziel.</description>
  <entrypoints view="view.js" theme="theme.css" logic="builtin"/>
  <assetsDir>assets</assetsDir>
  <config>
    <autoStartWhenAllReady>true</autoStartWhenAllReady>
    <cellsPerPlayer>8</cellsPerPlayer>
    <homeLength>4</homeLength>
    <enterMin>10</enterMin>
    <stepMin>9</stepMin>
    <doubleMin>10.5</doubleMin>
    <defaultTargetProfile>air_rifle_10m</defaultTargetProfile>
    <disciplineTargets>
      <Luftgewehr>air_rifle_10m</Luftgewehr>
      <LG>air_rifle_10m</LG>
      <Luftpistole>air_pistol_10m</Luftpistole>
      <LP>air_pistol_10m</LP>
      <Kleinkaliber>smallbore_50m_prone</Kleinkaliber>
      <KK-Gewehr>smallbore_50m_prone</KK-Gewehr>
      <KK>smallbore_50m_prone</KK>
    </disciplineTargets>
  </config>
</plugin>
