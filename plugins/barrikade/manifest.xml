<?xml version="1.0" encoding="UTF-8"?>
<plugin id="barrikade" label="Barrikade" version="1.0.0" mode="shared" kind="game">
  <description>Rennen zur Burg. 9+ geht ein Feld, 10.5 zwei. Eine Mauer blockiert; 10.0 hebt sie und legt sie hinter dich. 6–7 bleiben stehen.</description>
  <entrypoints view="view.js" theme="theme.css" logic="builtin"/>
  <assetsDir>assets</assetsDir>
  <config>
    <autoStartWhenAllReady>true</autoStartWhenAllReady>
    <pathLength>24</pathLength>
    <citadel>25</citadel>
    <barricadeSlots>4,8,14,19,22</barricadeSlots>
    <initialBarricades>8,14,22</initialBarricades>
    <stepMin>9</stepMin>
    <liftMin>10</liftMin>
    <surgeMin>10.5</surgeMin>
    <defaultTargetProfile>air_rifle_10m</defaultTargetProfile>
    <disciplineTargets>
      <Luftgewehr>air_rifle_10m</Luftgewehr>
      <LG>air_rifle_10m</LG>
      <Luftpistole>air_pistol_10m</Luftpistole>
      <LP>air_pistol_10m</LP>
      <Kleinkaliber>smallbore_50m_prone</Kleinkaliber>
      <KK-Gewehr>smallbore_50m_prone</KK-Gewehr>
      <KK>smallbore_50m_prone</KK>
    </disciplineTargets>
  </config>
</plugin>
